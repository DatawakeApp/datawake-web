---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Datawake says no to cookie banners for you, catches sites that keep tracking you anyway, and shows who is tracking you right now. Free and open source for Chrome and Firefox.',
  canonical,
} = Astro.props;

const url = canonical ?? Astro.url.href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://datawake.app/og.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://datawake.app/og.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f8fafc" />
    <script is:inline>
      // Phones and tablets can't run desktop browser extensions: mark them before first paint so
      // install buttons can turn into "Send to my computer" without a flash.
      (function () {
        var ua = navigator.userAgent;
        var ipad = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
        if (/Android|iPhone|iPad|iPod|Mobile/i.test(ua) || ipad) document.documentElement.classList.add('is-mobile');
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Sticky nav shadow
      const nav = document.querySelector('.nav');
      if (nav) {
        const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 10);
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // Scroll reveal
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.07 });
      document.querySelectorAll('.reveal').forEach(el => io.observe(el));

      // On phones, install buttons send the link to the user's computer instead of a dead end.
      if (document.documentElement.classList.contains('is-mobile')) {
        const toast = (msg: string) => {
          const t = document.createElement('div');
          t.className = 'toast';
          t.setAttribute('role', 'status');
          t.textContent = msg;
          document.body.append(t);
          setTimeout(() => t.remove(), 4000);
        };
        const share = async () => {
          const data = { title: 'Datawake', text: 'Install Datawake on my computer (Chrome or Firefox):', url: 'https://datawake.app' };
          try {
            if (navigator.share) { await navigator.share(data); return; }
            await navigator.clipboard.writeText(data.url);
            toast('Link copied. Open datawake.app on your computer to install.');
          } catch (err) {
            if ((err as Error)?.name !== 'AbortError') toast('Open datawake.app on your computer to install.');
          }
        };
        document.querySelectorAll<HTMLAnchorElement>('[data-install]').forEach((a) => {
          const label = [...a.childNodes].reverse().find((n) => n.nodeType === Node.TEXT_NODE && n.textContent?.trim());
          if (label) label.textContent = ' Send to my computer ';
          a.removeAttribute('target');
          a.addEventListener('click', (e) => { e.preventDefault(); void share(); });
        });
      }
    </script>
  </body>
</html>
