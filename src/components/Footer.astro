        Datawake
      </a>
      <p class="footer-tagline">Know who tracks you. Catch sites that ignore your Reject.</p>
    </div>

    <div class="footer-cols">
      <div class="footer-col">
        <p class="footer-col-title">Product</p>
        <a href="/features">Features</a>
        <a href="/pricing">Pricing</a>
        <a href="https://github.com/DatawakeApp/datawake" target="_blank" rel="noopener">GitHub</a>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">Legal</p>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Use</a>
        <a href="mailto:hello@datawake.app">Contact</a>
      </div>
    </div>

  </div>
  <div class="container footer-bottom">
    <p>© 2026 Datawake. Made with care.</p>
    <div class="footer-trust">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
      0 bytes sent to our servers
    </div>
  </div>
</footer>

<style>
.footer {
  background: var(--surface);
  border-top: 1px solid var(--border);
  padding-top: 56px;
}

.footer-inner {
  display: flex;
  gap: 80px;
  padding-bottom: 48px;
}

.footer-brand {
  flex: 1;
  min-width: 0;
}

.footer-logo {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-weight: 800;
  font-size: 16px;
  color: var(--navy);
  text-decoration: none;
  letter-spacing: -0.03em;
  margin-bottom: 8px;
}

.footer-tagline {
  font-size: 13.5px;
  color: var(--text-muted);
  line-height: 1.6;
  max-width: 260px;
}

.footer-cols {
  display: flex;
  gap: 56px;
}

.footer-col {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 120px;
}

.footer-col-title {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 4px;
}

.footer-col a {
  font-size: 14px;
  color: var(--text-soft);
  text-decoration: none;
  transition: color 160ms ease;
}

.footer-col a:hover { color: var(--navy); }

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20px;
  padding-bottom: 28px;
  border-top: 1px solid var(--border);
  gap: 16px;
  flex-wrap: wrap;
}

.footer-bottom p {
  font-size: 12.5px;
  color: var(--text-muted);
}

.footer-trust {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--accent-dark);
}

/* ── Waitlist ── */
.footer-waitlist {
  background: var(--navy);
  padding: 48px 0;
}
.fw-inner {
  display: flex;
  align-items: center;
  gap: 48px;
}
.fw-text { flex: 1; min-width: 0; }
.fw-heading {
  font-size: 20px;
  font-weight: 700;
  color: #eef2f7;
  letter-spacing: -0.02em;
  margin-bottom: 4px;
}
.fw-sub {
  font-size: 14px;
  color: rgba(255,255,255,0.55);
  line-height: 1.5;
}
.fw-form {
  display: flex;
  gap: 8px;
  flex: 0 0 auto;
}
.fw-input {
  padding: 11px 16px;
  border-radius: 10px;
  border: 1.5px solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.07);
  color: #eef2f7;
  font-size: 14px;
  width: 220px;
  transition: border-color 160ms ease;
  font-family: inherit;
}
.fw-input::placeholder { color: rgba(255,255,255,0.35); }
.fw-input:focus {
  outline: none;
  border-color: var(--accent);
}
.fw-btn {
  display: inline-block;
  text-decoration: none;
  padding: 11px 20px;
  background: var(--accent);
  color: var(--navy);
  border: none;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: background 160ms ease, transform 160ms ease;
  font-family: inherit;
  white-space: nowrap;
}
.fw-btn:hover {
  background: #4fcb98;
  transform: translateY(-1px);
}
.fw-sent .fw-form { display: none; }
.fw-sent .fw-sub::after {
  content: " You're on the list.";
  color: var(--accent);
  font-weight: 600;
}

@media (max-width: 768px) {
  .fw-inner { flex-direction: column; gap: 24px; align-items: flex-start; }
  .fw-form { width: 100%; }
  .fw-input { flex: 1; width: auto; }
  .footer-inner {
    flex-direction: column;
    gap: 40px;
  }
  .footer-cols {
    gap: 32px;
  }
}
</style>

