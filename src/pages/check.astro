---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Data Breach Check · Datawake"
  description="Check if your email address has appeared in a known data breach. Free, instant, and Datawake never sees or stores your email."
>

<Nav />

<!-- ─── PAGE HERO ─────────────────────────────────────────────────────── -->
<div class="page-hero">
  <div class="container">
    <h1>Has your email been in a breach?</h1>
    <p>Billions of accounts have been exposed in data breaches. Enter your email to see if yours is one of them. It takes a second and there is nothing to set up.</p>
  </div>
</div>

<!-- ─── TOOL ──────────────────────────────────────────────────────────── -->
<section class="section">
  <div class="container">
    <div class="check-layout">

      <!-- Main tool -->
      <div class="check-main">

        <!-- Check form -->
        <div id="check-step" class="check-card">
          <h2>Check an email address</h2>

          <div class="check-form-row">
            <input
              type="email"
              id="email-input"
              placeholder="you@example.com"
              autocomplete="email"
            />
            <button id="check-btn" class="btn btn-primary">
              <span id="check-btn-text">Check</span>
              <svg id="check-spinner" class="spinner" style="display:none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            </button>
          </div>
          <p id="check-error" class="field-error" style="display:none;"></p>

          <p class="check-note">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Your email is only used for this check. Datawake never sees or stores it.
          </p>
        </div>

        <!-- Results area -->
        <div id="results" style="display:none;">
          <!-- Clean result -->
          <div id="result-clean" class="result-clean" style="display:none;">
            <div class="result-clean-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h3>Good news. No breaches found.</h3>
            <p id="result-clean-email"></p>
          </div>

          <!-- Breaches found -->
          <div id="result-breaches" style="display:none;">
            <div class="result-breaches-header">
              <div class="result-breaches-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              </div>
              <div>
                <h3 id="breach-count-heading"></h3>
                <p id="breach-count-email" class="result-sub"></p>
              </div>
            </div>
            <div id="breach-list" class="breach-list"></div>
          </div>
          <p class="source-credit">Breach data: <a href="https://xposedornot.com" target="_blank" rel="noopener">XposedOrNot</a></p>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="check-aside">
        <div class="aside-block">
          <h3>About this check</h3>
          <p>Your email is checked against a database of known breaches covering thousands of incidents and billions of records. A clean result means it is not in any breach on record, not that it has never leaked.</p>
        </div>
        <div class="aside-block">
          <h3>Your privacy</h3>
          <ul class="aside-list">
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Datawake never sees or stores your email
            </li>
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              No account, no key, nothing to set up
            </li>
            <li>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              This page is open source, so you can check it
            </li>
          </ul>
        </div>
        <div class="aside-block aside-cta">
          <h3>Get alerts when new breaches appear</h3>
          <p>Datawake Pro watches for new breaches that include your email and lets you know as soon as one is found.</p>
          <a href="/pricing" class="btn btn-primary" style="width:100%; justify-content:center; margin-top:12px;">See Pro</a>
        </div>
      </aside>

    </div>
  </div>
</section>

<Footer />

</Base>

<style>
/* ── Layout ──────────────────────────────────────────────── */
.check-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 48px;
  align-items: start;
}

/* Grid and flex children default to their content's width; let them shrink on phones. */
.check-layout > *, .check-form-row input { min-width: 0; }

@media (max-width: 900px) {
  .check-layout {
    grid-template-columns: 1fr;
  }
  .check-aside { order: 2; }
}


/* ── Card ────────────────────────────────────────────────── */
.check-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 40px;
  margin-bottom: 24px;
}

.check-card h2 {
  margin: 0 0 8px;
  font-size: 22px;
}

.check-card > p {
  color: var(--text-soft);
  line-height: 1.7;
  margin-bottom: 28px;
}

/* ── Check form ──────────────────────────────────────────── */
.check-form-row {
  display: flex;
  gap: 10px;
  margin-bottom: 12px;
}

.check-form-row input[type="email"] {
  flex: 1;
  height: 50px;
  border: 1.5px solid var(--border);
  border-radius: 12px;
  padding: 0 18px;
  font-size: 16px;
  font-family: 'Inter', sans-serif;
  color: var(--text);
  background: var(--bg);
  transition: border-color 0.15s;
}

.check-form-row input[type="email"]:focus {
  outline: none;
  border-color: var(--accent);
}

.check-note {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--text-muted);
  flex-wrap: wrap;
}

.check-note svg { flex-shrink: 0; color: var(--accent-dark); }

.text-btn {
  background: none;
  border: none;
  padding: 0;
  color: var(--accent-dark);
  font-size: 13px;
  cursor: pointer;
  text-decoration: underline;
  font-family: inherit;
}

.field-error {
  font-size: 13.5px;
  color: #dc2626;
  margin-top: 8px;
}

/* ── Spinner ─────────────────────────────────────────────── */
.spinner {
  width: 18px;
  height: 18px;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ── Result: clean ───────────────────────────────────────── */
.result-clean {
  text-align: center;
  padding: 48px 32px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
}

.result-clean-icon {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: rgba(91,214,165,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  color: var(--accent-dark);
}

.result-clean-icon svg { width: 32px; height: 32px; }

.result-clean h3 {
  font-size: 22px;
  margin: 0 0 8px;
  color: var(--text);
}

.result-clean p {
  color: var(--text-soft);
  font-size: 15px;
}

/* ── Result: breaches ────────────────────────────────────── */
.result-breaches-header {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  background: rgba(239,68,68,0.06);
  border: 1px solid rgba(239,68,68,0.2);
  border-radius: 14px;
  padding: 20px 24px;
  margin-bottom: 24px;
}

.result-breaches-icon {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(239,68,68,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #dc2626;
}

.result-breaches-icon svg { width: 22px; height: 22px; }

.result-breaches-header h3 {
  margin: 0 0 4px;
  font-size: 18px;
  color: var(--text);
}

.result-sub { color: var(--text-soft); font-size: 14px; margin: 0; }

.breach-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* ── Aside ───────────────────────────────────────────────── */
.aside-block {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 24px;
  margin-bottom: 16px;
}

.aside-block h3 {
  font-size: 15px;
  margin: 0 0 10px;
  color: var(--text);
}

.aside-block p {
  font-size: 14px;
  color: var(--text-soft);
  line-height: 1.7;
  margin: 0;
}

.aside-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.aside-list li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 14px;
  color: var(--text-soft);
  line-height: 1.5;
}

.aside-list li svg { flex-shrink: 0; color: var(--accent-dark); margin-top: 2px; }

.aside-cta { background: rgba(91,214,165,0.06); border-color: rgba(91,214,165,0.25); }
.aside-cta h3 { color: var(--navy); }

/* Phones: placed last so these win over the base rules above */
@media (max-width: 600px) {
  .check-card { padding: 24px 20px; }
  .check-card h2 { font-size: 20px; margin-bottom: 14px; }
  .check-form-row { flex-direction: column; }
  .check-form-row input[type="email"] { flex: none; height: 52px; font-size: 16px; }
  .check-form-row button { width: 100%; justify-content: center; min-height: 52px; }
  .check-note { align-items: flex-start; flex-wrap: nowrap; line-height: 1.5; }
  .check-note svg { margin-top: 3px; }
  .breach-card { padding: 18px 20px; }
}

.breach-more { width: 100%; justify-content: center; margin-top: 4px; }
</style>

<script>
// Breach lookup straight from the visitor's browser: no key, no account, nothing passes through
// Datawake. The provider's terms ask for a credit wherever results are shown (under the results).
const API = 'https://api.xposedornot.com/v1/breach-analytics?email=';

interface BreachDetail {
  breach: string;
  domain?: string;
  xposed_date?: string;
  xposed_data?: string;
  xposed_records?: number;
  password_risk?: string;
}

const emailInput   = document.getElementById('email-input') as HTMLInputElement;
const checkBtn     = document.getElementById('check-btn') as HTMLButtonElement;
const checkBtnText = document.getElementById('check-btn-text')!;
const checkSpinner = document.getElementById('check-spinner')!;
const checkError   = document.getElementById('check-error')!;
const results      = document.getElementById('results')!;
const resultClean  = document.getElementById('result-clean')!;
const resultCleanEmail = document.getElementById('result-clean-email')!;
const resultBreaches = document.getElementById('result-breaches')!;
const breachCountHeading = document.getElementById('breach-count-heading')!;
const breachCountEmail = document.getElementById('breach-count-email')!;
const breachList   = document.getElementById('breach-list')!;

checkBtn.addEventListener('click', runCheck);
emailInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') runCheck(); });

async function runCheck() {
  const email = emailInput.value.trim();
  if (!email) return showError('Please enter an email address.');
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError("That doesn't look like a valid email address.");

  clearError();
  setLoading(true);
  results.style.display = 'none';
  try {
    const res = await fetch(API + encodeURIComponent(email));
    if (res.status === 429) return showError('Too many checks from this connection. Please wait a minute and try again.');
    if (!res.ok) throw new Error(`status ${res.status}`);
    const data = await res.json();
    const details: BreachDetail[] = data?.ExposedBreaches?.breaches_details ?? [];
    if (details.length === 0) showClean(email);
    else showBreaches(email, details);
  } catch (err) {
    showError("We couldn't run the check just now. Please check your connection and try again.");
    console.error(err);
  } finally {
    setLoading(false);
  }
}

function showClean(email: string) {
  results.style.display = 'block';
  resultClean.style.display = 'block';
  resultBreaches.style.display = 'none';
  resultCleanEmail.textContent = `${email} is not in any breach on record. It's worth checking again from time to time.`;
}

function showBreaches(email: string, breaches: BreachDetail[]) {
  results.style.display = 'block';
  resultClean.style.display = 'none';
  resultBreaches.style.display = 'block';
  breachCountHeading.textContent = `Found in ${breaches.length} breach${breaches.length === 1 ? '' : 'es'}`;
  breachCountEmail.textContent = email;
  const sorted = [...breaches].sort((a, b) => Number(b.xposed_date ?? 0) - Number(a.xposed_date ?? 0));
  const draw = (limit: number) => {
    breachList.replaceChildren(...sorted.slice(0, limit).map(buildBreachCard));
    if (sorted.length > limit) {
      const more = document.createElement('button');
      more.type = 'button';
      more.className = 'btn btn-outline breach-more';
      more.textContent = `Show all ${sorted.length} breaches`;
      more.addEventListener('click', () => draw(sorted.length));
      breachList.append(more);
    }
  };
  draw(BREACHES_SHOWN);
}

const BREACHES_SHOWN = 10;

/** "ManchesterAirportsGroup" reads as "Manchester Airports Group"; short names like "LinkedIn" stay. */
function readableName(name: string): string {
  const humps = name.match(/[a-z][A-Z]/g)?.length ?? 0;
  return humps >= 2 ? name.replace(/([a-z])([A-Z])/g, '$1 $2') : name;
}

/** Built with DOM text nodes, never innerHTML: the data comes from an outside service. */
function buildBreachCard(b: BreachDetail): HTMLElement {
  const el = (tag: string, cls: string, text?: string) => {
    const n = document.createElement(tag);
    n.className = cls;
    if (text) n.textContent = text;
    return n;
  };
  const card = el('div', 'breach-card');
  const meta = [b.xposed_date, b.xposed_records ? `${formatCount(b.xposed_records)} accounts` : ''].filter(Boolean).join(' · ');
  const header = el('div', 'breach-card-header');
  const head = el('div', '');
  head.append(el('div', 'breach-title', readableName(b.breach)), el('div', 'breach-meta', meta));
  header.append(head);
  const exposed = (b.xposed_data ?? '').split(';').map((s) => s.trim()).filter(Boolean);
  const chips = el('div', 'breach-chips');
  if (b.password_risk === 'plaintext') chips.append(el('span', 'data-chip data-chip--warn', 'Passwords in plain text'));
  for (const d of exposed.slice(0, 6)) chips.append(el('span', 'data-chip', d));
  if (exposed.length > 6) chips.append(el('span', 'data-chip data-chip--more', `+${exposed.length - 6} more`));
  card.append(header, chips);
  return card;
}

function formatCount(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `${Math.round(n / 1_000)}K`;
  return String(n);
}

function setLoading(loading: boolean) {
  checkBtnText.textContent = loading ? 'Checking…' : 'Check';
  checkSpinner.style.display = loading ? 'block' : 'none';
  checkBtn.disabled = loading;
  emailInput.disabled = loading;
}

function showError(msg: string) {
  checkError.textContent = msg;
  checkError.style.display = 'block';
}

function clearError() {
  checkError.textContent = '';
  checkError.style.display = 'none';
}
</script>

<style is:global>
/* ── Breach card ─────────────────────────────────────────── */
.breach-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px 24px;
}

.breach-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12px;
}

.breach-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 3px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.breach-meta {
  font-size: 13px;
  color: var(--text-muted);
}

.breach-unverified {
  font-size: 11px;
  font-weight: 600;
  padding: 2px 7px;
  background: rgba(245,158,11,0.12);
  color: #b45309;
  border-radius: 999px;
  letter-spacing: 0.03em;
}

.breach-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.data-chip {
  font-size: 12px;
  padding: 3px 10px;
  background: rgba(15,23,42,0.06);
  color: var(--text-soft);
  border-radius: 999px;
  white-space: nowrap;
}

.data-chip--warn {
  background: rgba(229,72,77,0.1);
  color: #b42318;
}

.source-credit {
  margin-top: 10px;
  font-size: 12.5px;
  color: var(--text-muted);
}

.source-credit a { color: inherit; }

.data-chip--more {
  background: rgba(91,214,165,0.1);
  color: var(--accent-dark);
}
</style>
