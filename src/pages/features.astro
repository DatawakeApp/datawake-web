---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { INSTALL_CHROME } from '../lib/links';
---
<Base
  title="Features · Datawake"
  description="Everything Datawake shows you: real-time tracker detection, cross-site tracking, data broker exposure, breach checks, and more."
>

<Nav />

<!-- ─── HERO ──────────────────────────────────────────────────────────── -->
<div class="feat-hero">
  <div class="container">
    <h1 class="reveal" style="--delay:60ms">Everything Datawake does for you</h1>
    <p class="feat-hero-sub reveal" style="--delay:120ms">
      Says no to cookie banners for you, catches the sites that keep tracking you, and shows who is tracking you right now. Everything stays on your device.
    </p>
  </div>
</div>

<!-- ─── SECTIONS ──────────────────────────────────────────────────────── -->
<div class="feat-sections">

    <!-- PANEL 1: Real-time monitoring -->
    <div class="feat-panel cat-blue">
      <div class="panel-split">

        <div class="panel-left">
          <h2>See who's on a page the second it loads</h2>
          <p class="panel-desc">Every website you visit loads invisible third-party scripts in the background. Datawake catches them as they appear and shows you exactly who's there.</p>

          <div class="feat-list">
            <div class="feat-item cat-blue">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Tracker detection on every page</div>
                <div class="feat-item-desc">Every third-party company loading in the background, identified the moment you land on a site.</div>
              </div>
            </div>
            <div class="feat-item cat-blue">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Company names, not domain names</div>
                <div class="feat-item-desc">You see "Google (Alphabet)", not "doubleclick.net". The actual company, in plain language.</div>
              </div>
            </div>
            <div class="feat-item cat-blue">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              </div>
              <div>
                <div class="feat-item-name">What each tracker actually does</div>
                <div class="feat-item-desc">Showing you ads, watching what you do, recording your screen or linking to your social accounts, with a high, medium or low risk level.</div>
              </div>
            </div>
            <div class="feat-item cat-blue">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Who is active right now</div>
                <div class="feat-item-desc">The popup updates live and marks the companies sending data at this moment, so you see tracking as it happens.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="panel-right">
          <img class="hero-popup" src="/img/popup.png" width="380" height="620" loading="lazy" alt="The Datawake popup: companies tracking you on this site, grouped by what they do, with the ones active now marked." />
        </div>

      </div>
    </div>

    <!-- PANEL 2: Violation detection -->
    <div class="feat-panel cat-red">
      <div class="panel-split">

        <div class="panel-left">
          <h2>Catch sites that track you after you click Reject</h2>
          <p class="panel-desc">Datawake declines cookie banners for you, then checks what happens next. New tracking cookies from known ad and analytics companies, and fingerprinting scripts, are flagged as violations with a full receipt.</p>

          <div class="feat-list">
            <div class="feat-item cat-red">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m10.29 3.86-8.22 14.24A2 2 0 0 0 3.77 21h16.46a2 2 0 0 0 1.7-3.1L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Says no for you</div>
                <div class="feat-item-desc">Datawake clicks Reject on cookie banners from the major consent platforms and sends the Global Privacy Control signal. Nothing to set up.</div>
              </div>
            </div>
            <div class="feat-item cat-red">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Catches tracking after Reject</div>
                <div class="feat-item-desc">If a site sets tracking cookies or fingerprints your device after you said no, it is logged with the cookie names, the companies and the time.</div>
              </div>
            </div>
            <div class="feat-item cat-red">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Report it, or share it</div>
                <div class="feat-item-desc">Send a complaint to your data protection authority, written from the evidence, or share a receipt of what you caught.</div>
              </div>
            </div>
            <div class="feat-item cat-red">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m10.5 8.5 5 3.5-5 3.5z"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Pay to refuse, flagged</div>
                <div class="feat-item-desc">Some sites only let you refuse tracking if you subscribe. Datawake tells you instead of deciding for you, including when Reject quietly leads to a pay wall.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="panel-right">
          <div class="panel-preview cat-red">
            <div class="pp-bar">
              <span class="pp-title">Violation detected</span>
              <span class="pp-risk-badge" style="background:rgba(239,68,68,0.15);color:#f87171">AFTER REJECT</span>
            </div>
            <div class="pp-risk-row" style="color:#f87171">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color:#f87171"><path d="m10.29 3.86-8.22 14.24A2 2 0 0 0 3.77 21h16.46a2 2 0 0 0 1.7-3.1L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
              <span>You clicked Reject. This site set 3 tracking cookies anyway.</span>
            </div>
            <div class="pp-divider"></div>
            <div class="pp-section-label">Cookies set after Reject</div>
            <div class="pp-breach-item" style="border-bottom:1px solid rgba(255,255,255,0.05)">
              <div class="pp-breach-name" style="font-family:monospace;font-size:11px">_fbp</div>
              <div class="pp-breach-date">facebook.com</div>
            </div>
            <div class="pp-breach-item" style="border-bottom:1px solid rgba(255,255,255,0.05)">
              <div class="pp-breach-name" style="font-family:monospace;font-size:11px">_gcl_au</div>
              <div class="pp-breach-date">google.com</div>
            </div>
            <div class="pp-breach-item">
              <div class="pp-breach-name" style="font-family:monospace;font-size:11px">_tt_enable_cookie</div>
              <div class="pp-breach-date">tiktok.com</div>
            </div>
            <div class="pp-footer">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Stored locally · Logged with timestamp
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- PANEL 3: Digital footprint -->
    <div class="feat-panel cat-violet">
      <div class="panel-split">

        <div class="panel-left">
          <h2>90 days of your tracking history, stored locally</h2>
          <p class="panel-desc">Datawake keeps a rolling record of every company that has tracked you across every site you visit. It stays on your device. Nobody else can see it.</p>

          <div class="feat-list">
            <div class="feat-item cat-violet">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <div>
                <div class="feat-item-name">90-day browsing summary</div>
                <div class="feat-item-desc">Sites visited, unique companies that tracked you, and total tracker connections over the last three months.</div>
              </div>
            </div>
            <div class="feat-item cat-violet">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Who follows you across the web</div>
                <div class="feat-item-desc">Some companies appear on dozens of sites. See which ones follow you everywhere and how many times they've seen you.</div>
              </div>
            </div>
            <div class="feat-item cat-violet">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Tracking by category</div>
                <div class="feat-item-desc">How much advertising vs. analytics vs. social tracking you're receiving. See where the concentration is.</div>
              </div>
            </div>
            <div class="feat-item cat-violet">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Ad interest profile</div>
                <div class="feat-item-desc">The categories that advertisers are likely assigning to you based on your browsing. The profile they use to decide which ads you see.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="panel-right">
          <div class="panel-preview cat-violet">
            <div class="pp-bar">
              <span class="pp-title">Your 90-day overview</span>
            </div>
            <div class="pp-stats-row">
              <div class="pp-stat">
                <span class="pp-stat-num">142</span>
                <span class="pp-stat-label">sites visited</span>
              </div>
              <div class="pp-stat">
                <span class="pp-stat-num">38</span>
                <span class="pp-stat-label">companies</span>
              </div>
              <div class="pp-stat">
                <span class="pp-stat-num">1.2k</span>
                <span class="pp-stat-label">connections</span>
              </div>
            </div>
            <div class="pp-divider"></div>
            <div class="pp-section-label">Who follows you most</div>
            <div class="pp-bar-row">
              <span class="pp-bar-name">Google</span>
              <div class="pp-bar-track"><div class="pp-bar-fill" style="width:88%; background:var(--cat-violet)"></div></div>
              <span class="pp-bar-count">89</span>
            </div>
            <div class="pp-bar-row">
              <span class="pp-bar-name">Meta</span>
              <div class="pp-bar-track"><div class="pp-bar-fill" style="width:66%; background:var(--cat-violet)"></div></div>
              <span class="pp-bar-count">67</span>
            </div>
            <div class="pp-bar-row">
              <span class="pp-bar-name">DoubleClick</span>
              <div class="pp-bar-track"><div class="pp-bar-fill" style="width:44%; background:var(--cat-violet)"></div></div>
              <span class="pp-bar-count">45</span>
            </div>
            <div class="pp-bar-row">
              <span class="pp-bar-name">LinkedIn</span>
              <div class="pp-bar-track"><div class="pp-bar-fill" style="width:28%; background:var(--cat-violet)"></div></div>
              <span class="pp-bar-count">29</span>
            </div>
            <div class="pp-footer">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
              Stored locally · 90-day rolling window
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- PANEL 3: Data flow -->
    <div class="feat-panel cat-amber">
      <div class="panel-split">

        <div class="panel-left">
          <h2>Not just who tracked you. Where your data went.</h2>
          <p class="panel-desc">Trackers aren't all the same. Some companies use your data internally. Others sell it. Datawake shows you the difference, and flags data brokers when they're watching.</p>

          <div class="feat-list">
            <div class="feat-item cat-amber">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 8 16 12 12 16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              </div>
              <div>
                <div class="feat-item-name">What companies do with your data</div>
                <div class="feat-item-desc">Internal use, shared with partners, or sold to brokers. Datawake classifies each tracker so you know what actually happens to your data.</div>
              </div>
            </div>
            <div class="feat-item cat-amber">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Data broker identification</div>
                <div class="feat-item-desc">Data brokers buy and sell personal information as their primary business. Datawake highlights when one is watching your browsing.</div>
              </div>
            </div>
            <div class="feat-item cat-amber">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Filter by who sells your data</div>
                <div class="feat-item-desc">See every broker and exchange whose trackers loaded on sites you visited, and which companies share your data for ads.</div>
              </div>
            </div>
            <div class="feat-item cat-amber">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Full broker report <span class="pro-badge">Pro</span></div>
                <div class="feat-item-desc">30+ known data brokers, whether they've seen your browsing, and what data categories they trade in.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="panel-right">
          <div class="panel-preview cat-amber">
            <div class="pp-bar">
              <span class="pp-title">Data broker exposure</span>
              <span class="pp-risk-badge">HIGH RISK</span>
            </div>
            <div class="pp-risk-row">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              <span>3 brokers have seen your browsing this month</span>
            </div>
            <div class="pp-divider"></div>
            <div class="pp-broker-row">
              <div class="pp-binfo">
                <div class="pp-bname">Acxiom</div>
                <div class="pp-bcat">People data, consumer profiles</div>
              </div>
              <span class="pp-btype pp-sells">Sells</span>
            </div>
            <div class="pp-broker-row">
              <div class="pp-binfo">
                <div class="pp-bname">LiveRamp</div>
                <div class="pp-bcat">Identity resolution</div>
              </div>
              <span class="pp-btype pp-shares">Shares</span>
            </div>
            <div class="pp-broker-row">
              <div class="pp-binfo">
                <div class="pp-bname">Oracle DaaS</div>
                <div class="pp-bcat">Audience segments</div>
              </div>
              <span class="pp-btype pp-sells">Sells</span>
            </div>
            <div class="pp-broker-more">+ 27 more brokers in full report</div>
            <div class="pp-footer">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Full report available with Pro
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- PANEL 4: Breach check -->
    <div class="feat-panel cat-red">
      <div class="panel-split">

        <div class="panel-left">
          <h2>Check if your email has been in a breach</h2>
          <p class="panel-desc">Billions of credentials have been exposed in publicly known data breaches. Datawake checks your email against a database of known breaches and tells you exactly which services exposed your data and what was leaked.</p>

          <div class="feat-list">
            <div class="feat-item cat-red">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Email breach lookup</div>
                <div class="feat-item-desc">Check any email right here on this website, or in the extension. Nothing to set up. <a href="/check" style="color:var(--cat-red); font-weight:600;">Try it now</a></div>
              </div>
            </div>
            <div class="feat-item cat-red">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              </div>
              <div>
                <div class="feat-item-name">What was leaked in each breach</div>
                <div class="feat-item-desc">Passwords, email addresses, phone numbers, payment info. You see exactly what was exposed, not just which company was hit.</div>
              </div>
            </div>
            <div class="feat-item cat-red">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Your email never reaches us</div>
                <div class="feat-item-desc">The lookup goes straight from your browser to the breach database. Datawake never sees or stores your email address.</div>
              </div>
            </div>
            <div class="feat-item cat-red">
              <div class="feat-item-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
              </div>
              <div>
                <div class="feat-item-name">Weekly breach alerts <span class="pro-badge">Pro</span></div>
                <div class="feat-item-desc">Get an email the moment a new breach contains your address. You find out quickly, not months later.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="panel-right">
          <div class="panel-preview cat-red">
            <div class="pp-bar">
              <span class="pp-title">Breach check results</span>
            </div>
            <div class="pp-breach-email">you@example.com</div>
            <div class="pp-breach-summary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
              Found in 3 breaches
            </div>
