        </g>
        <g class="tr-row" style="--i:4">
          <rect x="342" y="310" width="180" height="34" rx="6" fill="#161b25"/>
          <rect x="342" y="310" width="3" height="34" rx="1.5" fill="#0a66c2"/>
          <text x="354" y="324" fill="#eef2f7" font-size="10.5" font-weight="700" font-family="Inter, sans-serif">LinkedIn Insight</text>
          <text x="354" y="337" fill="#7e8a99" font-size="8.5" font-family="Inter, sans-serif">Advertising</text>
          <rect x="473" y="316" width="35" height="14" rx="7" fill="rgba(245,158,11,0.15)"/>
          <text x="490" y="326" fill="#f59e0b" font-size="7" font-weight="700" text-anchor="middle" font-family="Inter, sans-serif">MED</text>
