---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Datawake · Catch sites that track you after you say Reject">

<Nav />

<!-- ─── HERO ─────────────────────────────────────────────────────────── -->
<section class="hero">
  <div class="hero-inner container">

    <div class="hero-text">
      <h1 class="display">
        You clicked Reject.<br>They tracked you anyway.
      </h1>

      <p class="hero-sub">
        Research shows more than half of websites keep setting tracking cookies after you click Reject. That often breaks privacy law, and almost no one realises.
        Datawake catches them and shows you every company tracking you, in real time.
      </p>

      <div class="hero-ctas">
        <a href="https://github.com/DatawakeApp/datawake" class="btn btn-primary btn-lg" target="_blank" rel="noopener">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Add to Chrome, free
        </a>
        <a href="https://github.com/DatawakeApp/datawake" class="btn btn-outline btn-lg" target="_blank" rel="noopener">Add to Firefox</a>
      </div>

      <p class="hero-note">
        <span>No account needed</span>
        <span>Works on Chrome, Firefox and Edge</span>
        <span>Open source</span>
      </p>
    </div>

    <div class="hero-visual">
      <svg viewBox="0 0 540 374" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
