        <text x="354" y="76" fill="#eef2f7" font-size="12.5" font-weight="700" font-family="Inter, sans-serif">Datawake</text>
        <circle cx="509" cy="71" r="7" fill="#5bd6a5" opacity="0.12"/>
        <circle cx="509" cy="71" r="4" fill="#5bd6a5"/>
        <line x1="336" y1="92" x2="528" y2="92" stroke="#222a38" stroke-width="1"/>
